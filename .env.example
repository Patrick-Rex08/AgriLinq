# Backend Environment Variables (Production Host)
ENVIRONMENT=production
PROJECT_NAME="AgriLink API"
API_V1_STR=/api/v1
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# CORS: Set allowed origins (Vercel deployment URL)
BACKEND_CORS_ORIGINS=["https://*.vercel.app","http://localhost:5173"]

# PostgreSQL Database Connection URL (Recommended: Free Neon or Supabase database)
# Example:
# DATABASE_URL=postgresql+psycopg2://<user>:<password>@<host>/<dbname>?sslmode=require
